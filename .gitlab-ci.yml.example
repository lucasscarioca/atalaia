stages:
  - test
  - regression

variables:
  PIP_DISABLE_PIP_VERSION_CHECK: "1"
  UV_PROJECT_ENVIRONMENT: .venv

local-evals:
  stage: test
  image: python:3.12
  script:
    - pip install uv
    - uv sync --dev
    - uv run atal run --suite evals.sample:suite --min-accuracy 0.95

remote-regression:
  stage: regression
  image: python:3.12
  rules:
    - if: '$ATALAIA_API_URL && $ATALAIA_TOKEN && $ATALAIA_REFERENCE_RUN_ID'
      when: on_success
    - when: never
  script:
    - pip install uv
    - uv sync --dev
    - |
      set -euo pipefail
      # Assumes a worker is already running against the remote API.
      tmp_json="$(mktemp)"
      uv run atal run \
        --suite evals.sample:suite \
        --remote \
        --wait \
        --json \
        --api-url "$ATALAIA_API_URL" \
        --token "$ATALAIA_TOKEN" \
        --project-slug "${ATALAIA_PROJECT_SLUG:-default}" \
        | tee "$tmp_json"
      current_run_id="$(python - "$tmp_json" <<'PY'
import json
import sys
from pathlib import Path

payload = json.loads(Path(sys.argv[1]).read_text())
print(payload["run_id"])
PY
)"
      uv run atal check \
        --run-id "$current_run_id" \
        --against "$ATALAIA_REFERENCE_RUN_ID" \
        --api-url "$ATALAIA_API_URL" \
        --token "$ATALAIA_TOKEN" \
        --max-failed-delta 0 \
        --max-error-delta 0
